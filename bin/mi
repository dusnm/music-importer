#!/bin/bash
# Host-side front end for the music-importer container: symlink it onto your PATH as `mi`.
#
# Anything that isn't a host command below is passed to the CLI inside the container, with
# host paths translated to container paths (read from the container's own mounts, so it
# works wherever the music, inbox and data folders live).
#
# Settings (environment): MI_CONTAINER (default music-importer), MI_DEPLOY_CMD (how `mi
# deploy` rebuilds and restarts; default: `homelab build music-importer && homelab up
# music-importer` when the homelab command is available).

set -euo pipefail

SERVICE="${MI_CONTAINER:-music-importer}"
# The project folder is wherever this script really lives (it's usually run via a symlink).
PROJECT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"

error() {
    echo "mi: $*" >&2
    exit 1
}

# host path -> container path for every bind mount of the container, most specific first
PATH_MAP=()
load_mounts() {
    (( ${#PATH_MAP[@]} )) && return 0
    local line
    while IFS= read -r line; do
        [[ -n "$line" ]] && PATH_MAP+=("$line")
    done < <(docker inspect -f '{{range .Mounts}}{{if eq .Type "bind"}}{{.Source}}={{.Destination}}{{println}}{{end}}{{end}}' \
                 "$SERVICE" 2>/dev/null | awk -F= '{ print length($1) "\t" $0 }' | sort -rn | cut -f2-)
    (( ${#PATH_MAP[@]} )) || error "the $SERVICE container does not exist (deploy it first)"
}

# The host folder mounted at a container path, e.g. host_path /inbox
host_path() {
    load_mounts
    local entry
    for entry in "${PATH_MAP[@]}"; do
        [[ "${entry#*=}" == "$1" ]] && { printf '%s\n' "${entry%%=*}"; return 0; }
    done
    return 1
}

usage() {
    cat <<'EOF'
Usage: mi COMMAND [ARGS...]

Work that changes the library runs as a background job: the command queues it and returns.
Add --fg to run it right here and wait instead.

Importing (queued as background jobs):
  import DIR [--mbid ID | --as-is]   import a folder (host or container path)
  art DIR                            cover art of an album folder: normalise, or download if none
  lyrics [DIR] [--retry-all]         fetch lyrics for the library or one folder
  retag DIR [--mbid ID]              match a library album against MusicBrainz again
  find WORDS...                      search the library's album folders (artist, album, year)

DIR for art, lyrics and retag can also be search words, e.g. `mi retag plagues babylon`:
the album is picked when one clearly matches best, otherwise you choose from a list.
  bandcamp                           browse your Bandcamp collection and pick releases
  bandcamp album URL|TEXT...         import releases you own
  bandcamp artist URL|NAME           import (a choice of) an artist's releases you own
  bandcamp list [FILTER]             list what you own on Bandcamp (runs right away)
  slskd search [--lossless] WORDS... search Soulseek; folders by free slot and speed; pick to queue
  slskd downloads                    what slskd is downloading (finished folders get imported)
  slskd downloads clear [--failed]   remove finished downloads from slskd's list; --failed: only
                                     unsuccessful ones (queued and running downloads always stay)
  index                              re-register the library in the beets DB (runs right away)

Jobs:
  jobs [-n N]                        queued, running and the last N finished jobs
  jobs clear [--failed]              remove finished jobs from the list; --failed: only
                                     unsuccessful ones (queued and running jobs always stay)
  job ID [--log]                     one job: state, timings, outcome and log
  follow [ID] [--log]                live progress of a job (default: every queued/running one)
  cancel ID...                       cancel queued jobs, stop running ones
  retry ID...                        queue a failed/interrupted job again

On the host:
  status                             container state, inbox, active jobs and the last imports
  history [N]                        the last N imports (default 10)
  logs [-f] [N]                      container log (last N lines, default 100; -f follows)
  restart                            restart the container (a running job may finish first)
  deploy                             rebuild the image from the project and recreate it
  shell                              a shell inside the container
  help                               this text

Host paths under the container's mounts are translated (the music library -> /music/...,
the inbox -> /inbox/..., slskd downloads -> /downloads/...); container paths pass unchanged.
`mi COMMAND --help` shows the options of a command; `mi -v COMMAND` shows detailed logs.
EOF
}

# Translate one argument if it names an existing host path under a mapped folder.
to_container_path() {
    local arg="$1" real entry host ctr
    if [[ "$arg" != -* ]] && [[ -e "$arg" ]]; then
        load_mounts
        real="$(readlink -f -- "$arg")"
        for entry in "${PATH_MAP[@]}"; do
            host="${entry%%=*}"
            ctr="${entry#*=}"
            if [[ "$real" == "$host" || "$real" == "$host"/* ]]; then
                printf '%s\n' "$ctr${real#"$host"}"
                return
            fi
        done
    fi
    printf '%s\n' "$arg"
}

running() {
    [[ "$(docker inspect -f '{{.State.Running}}' "$SERVICE" 2>/dev/null)" == "true" ]]
}

in_container() {
    running || error "the $SERVICE container is not running (try: mi restart)"
    local args=() a tty=()
    for a in "$@"; do
        args+=("$(to_container_path "$a")")
    done
    # Interactive pickers need a terminal; scripts and pipes must not get one.
    [[ -t 0 && -t 1 ]] || tty=(-T)
    local tty_flag=(-i)
    [[ ${#tty[@]} -eq 0 ]] && tty_flag=(-it)
    exec docker exec "${tty_flag[@]}" "$SERVICE" music-importer "${args[@]}"
}

history() {
    local n="${1:-10}" data log
    data="$(host_path /data)" || error "the $SERVICE container has no /data mount"
    log="$data/imports.jsonl"
    [[ "$n" =~ ^[0-9]+$ ]] || error "history: N must be a number"
    [[ -f "$log" ]] || { echo "no imports yet"; return; }
    tail -n "$((n * 2))" "$log" | python3 -c "$(cat <<'PY'
import json, sys
records = [json.loads(line) for line in sys.stdin if line.strip()]
for i, r in enumerate(records):
    nxt = records[i + 1] if i + 1 < len(records) else None
    if (nxt and r.get('status') != 'imported' and nxt.get('folder') == r.get('folder')
            and nxt.get('status') == 'imported'):
        continue  # a first attempt that a fallback (e.g. as-is) then imported
    when = r.get('finished', r.get('started', '?')).replace('T', ' ')
    print(f"{when}  {r.get('status', '?')}  ({r.get('match', '-')})")
    print(f"    from {r['folder']}")
    for a in r.get('albums', []):
        print(f"    -> {a['dir']}  [{a.get('tracks', '?')} tracks]")
    for x in r.get('replaced', []):
        print(f"    replaced {x.get('from', '?')}")
    if r.get('download') not in (None, 'removed', 'gone'):
        print(f"    leftover folder: {r['download']}")
PY
)" | python3 -c "$(cat <<'PY'
import sys
# keep the last N entries (an entry starts with a non-indented line)
n = int(sys.argv[1]); entries = []
for line in sys.stdin:
    if not line.startswith(' '):
        entries.append([])
    if entries:
        entries[-1].append(line)
sys.stdout.write(''.join(''.join(e) for e in entries[-n:]))
PY
)" "$n"
}

status() {
    local state version
    state="$(docker inspect -f '{{.State.Status}}{{if .State.Health}} ({{.State.Health.Status}}){{end}} since {{.State.StartedAt}}' "$SERVICE" 2>/dev/null || echo 'not created')"
    version="$(docker exec "$SERVICE" python -c 'import music_importer as m; print(m.__version__)' 2>/dev/null || echo '?')"
    echo "container: $SERVICE $state"
    echo "version:   $version (project: $(sed -n 's/^version = "\(.*\)"/\1/p' "$PROJECT_DIR/pyproject.toml"))"
    local inbox
    inbox="$(host_path /inbox)" || inbox="(no inbox mounted)"
    echo
    echo "inbox ($inbox):"
    local found=0 d
    for d in "$inbox"/*/; do
        [[ -d "$d" ]] || continue
        d="${d%/}"
        [[ "$(basename "$d")" == _* ]] && continue
        echo "    waiting: $(basename "$d")"
        found=1
    done
    for d in "$inbox"/_not-imported/*/; do
        [[ -d "$d" ]] || continue
        echo "    NOT IMPORTED: $(basename "${d%/}")  (see the .txt note next to it)"
        found=1
    done
    (( found )) || echo "    empty"
    echo
    echo "jobs:"
    if running; then
        docker exec "$SERVICE" music-importer jobs -n 3 | sed 's/^/    /'
    else
        echo "    (container not running)"
    fi
    echo
    echo "last imports:"
    history 5 | sed 's/^/    /'
}

deploy() {
    if [[ -n "${MI_DEPLOY_CMD:-}" ]]; then
        bash -c "$MI_DEPLOY_CMD"
    elif command -v homelab >/dev/null; then
        homelab build music-importer && homelab up music-importer
    else
        error "deploy: set MI_DEPLOY_CMD to the command that rebuilds and restarts the container"
    fi
}

cmd="${1:-help}"
case "$cmd" in
    help|-h|--help)
        usage
        ;;
    status)
        status
        ;;
    history)
        history "${2:-10}"
        ;;
    logs)
        shift
        follow=()
        lines=100
        for a in "$@"; do
            case "$a" in
                -f|--follow) follow=(-f) ;;
                *[!0-9]*) error "logs: unexpected argument '$a'" ;;
                *) lines="$a" ;;
            esac
        done
        exec docker logs --tail "$lines" "${follow[@]}" "$SERVICE"
        ;;
    restart)
        docker restart -t 120 "$SERVICE" >/dev/null && echo "restarted $SERVICE"   # running job may finish first
        ;;
    deploy)
        deploy
        ;;
    inbox-path)   # for mi-remote: where the inbox is on this machine
        host_path /inbox || error "the $SERVICE container has no /inbox mount"
        ;;
    shell)
        running || error "the $SERVICE container is not running"
        exec docker exec -it "$SERVICE" bash
        ;;
    *)
        in_container "$@"
        ;;
esac
